{
  "name": "test-tracking-dashboard",
  "version": "1.0.0",
  "description": "Test tracking and media management system with OBS streaming",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-all": "npm install && cd client && npm install && cd ..",
    "build": "cd client && npm run build",
    "migrate": "node server/db/migrate.js",
    "migrate-projects": "node server/db/migrate-projects.js",
    "migrate-client-contacts": "node server/db/migrate-client-contacts.js",
    "migrate-media-categories": "node server/db/migrate-media-categories.js",
    "migrate-add-serial": "node server/db/migrate-add-serial-number.js",
    "migrate-calibration-history": "node server/db/migrate-calibration-history.js",
    "migrate-audit-log": "node server/db/migrate-audit-log.js",
    "check-db": "node server/db/check-structure.js"
  },
  "keywords": [
    "test-tracking",
    "calibration",
    "obs-streaming"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.6.1",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
